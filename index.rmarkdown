## Row {height="400px"}

### Column 1

```{r}
cashflow_df <- tibble(
  Type = c("Collections", "Payments"),
  Amount = c(total_collections, total_payments)
)

cashflow_df$Amount <- as.numeric(cashflow_df$Amount)

cashflow_df |>
  e_charts(Type, height = "100%") |>
  e_bar(
    Amount,
    barWidth = "40%",
    itemStyle = list(
      color = htmlwidgets::JS(
        "function(params){
           return params.name === 'Collections'
           ? '#89c7a1'
           : '#e68273';
         }"
      )
    )
  ) |>
  e_title(
    "Collections vs Payments",
    left = "center",
    top = 8,
    textStyle = list(fontSize = 14)
  ) |>
  e_y_axis(
    name = "Amount (₹)",
    nameLocation = "middle",
    nameGap = 45,
    axisLabel = list(
      formatter = htmlwidgets::JS(
        "function(value){
          if (Math.abs(value) >= 10000000) {
            return (value / 10000000) + 'Cr';
          } else if (Math.abs(value) >= 100000) {
            return (value / 100000) + 'L';
          } else if (Math.abs(value) >= 1000) {
            return (value / 1000) + 'K';
          } else {
            return value;
          }
        }"
      )
    )
  ) |>
  e_grid(
    left = 80,
    right = 30,
    top = 70,
    bottom = 50
  ) |>
  e_tooltip(
    trigger = "item",
    confine = TRUE,
    formatter = htmlwidgets::JS(
      "function(p){
         var amount = Number(p.value[1]); 

         return `
           <div style='font-size:12px; line-height:1.5'>
             <div><b>Label :</b> ${p.name}</div>
             <div><b>Amount :</b> ₹ ${amount.toLocaleString('en-IN')}</div>
           </div>
         `;
       }"
    )
  ) |>
  e_legend(FALSE)

```

### Column 2

```{r}

monthly_movement <- daybook %>%
  filter(ledger_name %in% c(
    "11101004 - ICICI bank-281305008509",
    "11101002 - VIjaya Bank -100800301000084"
  )) %>%
  mutate(
    date = as.Date(date, format = "%Y-%m-%d"),
    Month = floor_date(date, "month")
  ) %>%
  group_by(Month, ledger_name) %>%
  summarise(Net = sum(net_amount), .groups = "drop") %>%
  arrange(ledger_name, Month)

monthly_movement$Net <- as.numeric(monthly_movement$Net)

# Color mapping for each ledger
color_map <- c("11101004 - ICICI bank-281305008509" = "#a6dca1ff",   
               "11101002 - VIjaya Bank -100800301000084" = "#ff7f0e") 

# Generate the line chart with custom colors
monthly_movement %>%
  group_by(ledger_name) %>%
  e_charts(Month, height = "100%") %>%
  e_line(
    Net,
    symbol = "circle",
    symbolSize = 6
  ) %>%
  e_title(
    "Monthly Bank Movement",
    left = "center",
    top = 8,
    textStyle = list(fontSize = 14)
  ) %>%
  e_y_axis(
    name = "Net Amount (₹)",
    nameLocation = "middle",
    nameGap = 50,
    axisLabel = list(
      formatter = htmlwidgets::JS(
        "function(value){
          var sign = value < 0 ? '-' : '';
          var absVal = Math.abs(value);

          if (absVal >= 10000000) {
            return sign + (absVal / 10000000) + 'Cr';
          } else if (absVal >= 100000) {
            return sign + (absVal / 100000) + 'L';
          } else if (absVal >= 1000) {
            return sign + (absVal / 1000) + 'K';
          } else {
            return sign + absVal;
          }
        }"
      )
    )
  ) %>%
  e_grid(
    left = 80,
    right = 30,
    top = 65,
    bottom = 70
  ) %>%
  e_legend(
    bottom = 10,
    itemWidth = 12,
    itemHeight = 8,
    textStyle = list(fontSize = 11)
  ) %>%
  e_tooltip(
  trigger = "axis",
  confine = TRUE,
  formatter = htmlwidgets::JS(
    "function(params){

      function formatINR(val){
        var sign = val < 0 ? '-' : '';
        var absVal = Math.abs(Number(val));  // ✅ convert to number
        return sign + absVal.toLocaleString('en-IN');
      }

      var txt = '';
      params.forEach(function(p){
        var month = new Date(p.value[0])
          .toLocaleDateString('en-IN', { month: 'short', year: 'numeric' });

        txt += `
          <div style='margin-bottom:8px'>
            <b>${p.seriesName}</b><br>
            Month : ${month}<br>
            Net : ₹ ${formatINR(p.value[1])}
          </div>
        `;
      });

      return txt;
    }"
  )
)




```

